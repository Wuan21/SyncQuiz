# ── API (Production: set to your Render backend URL) ─────────────────────────
# Leave blank in dev (Vite proxy handles /api → localhost:5000)
# Example: https://syncquiz-backend.onrender.com/api
VITE_API_URL=

# ── Socket.IO (Production: set to your Render backend URL, no /api suffix) ────
# Leave blank in dev (Vite proxy handles /socket.io)
# Example: https://syncquiz-backend.onrender.com
VITE_SOCKET_URL=

# ── AWS Cognito (Optional, leave blank to use local fallback auth) ─────────────
VITE_AWS_COGNITO_USER_POOL_ID=your_user_pool_id_here
VITE_AWS_COGNITO_CLIENT_ID=your_client_id_here
