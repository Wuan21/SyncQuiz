# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://qn21012004_db_user:<db_password>@syncquiz.jyno9es.mongodb.net/?appName=SyncQuiz
MONGODB_DB_NAME=syncquiz

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── AI (Google Gemini) ────────────────────────────────────────────────────────
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_iam_access_key_id
AWS_SECRET_ACCESS_KEY=your_iam_secret_access_key

# S3
AWS_S3_BUCKET=syncquiz-media
# Optional: CloudFront CDN URL (leave empty to use S3 URL directly)
AWS_CLOUDFRONT_URL=https://dXXXXXXXXX.cloudfront.net

# SES (email) — must verify sender in AWS SES console
AWS_SES_FROM_EMAIL=no-reply@yourdomain.com

# Lambda (optional — used for thumbnail generation)
AWS_LAMBDA_THUMBNAIL_FN=syncquiz-generate-thumbnail

# Route 53 (managed via AWS console / Terraform, no runtime env needed)
# HOSTED_ZONE_ID=Z1234567890ABC
# DOMAIN=syncquiz.yourdomain.com
