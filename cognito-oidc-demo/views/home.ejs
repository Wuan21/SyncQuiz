<!-- views/home.ejs -->
<!DOCTYPE html>
<html>
<head>
    <title>Amazon Cognito authentication with Node example</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #0b0f19;
            color: #f3f4f6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }
        .card {
            background-color: #111827;
            border: 1px solid #1f2937;
            border-radius: 12px;
            padding: 32px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
            text-align: center;
        }
        h1 {
            color: #a78bfa;
            margin-bottom: 24px;
        }
        h2 {
            color: #34d399;
        }
        p {
            color: #9ca3af;
        }
        pre {
            background-color: #1f2937;
            padding: 16px;
            border-radius: 8px;
            text-align: left;
            overflow-x: auto;
            color: #38bdf8;
            font-size: 14px;
        }
        .btn {
            display: inline-block;
            background-color: #7c3aed;
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: background-color 0.2s;
            margin-top: 16px;
        }
        .btn:hover {
            background-color: #6d28d9;
        }
    </style>
</head>
<body>
<div class="card">
    <h1>Amazon Cognito User Pool Demo</h1>

    <% if (isAuthenticated) { %>
        <div>
            <h2>Welcome, <%= userInfo.username || userInfo.email || userInfo.sub %></h2>
            <p>Here are some attributes retrieved from Cognito ID Token / UserInfo:</p>
            <pre><%= JSON.stringify(userInfo, null, 4) %></pre>
        </div>
        <a href="/logout" class="btn" style="background-color: #ef4444;">Logout</a>
    <% } else { %>
        <p>Please log in to continue</p>
        <a href="/login" class="btn">Login</a>
    <% } %>
</div>
</body>
</html>
